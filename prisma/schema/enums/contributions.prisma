// ============================================================
// ENUMS — CONTRIBUTIONS COMMUNAUTAIRES
// ============================================================

enum ContributionStatus {
  DRAFT             // Brouillon privé modifiable par son auteur
  PENDING_REVIEW    // Soumis et en attente de validation par l'équipe
  CHANGES_REQUESTED // Modifications demandées au contributeur
  APPROVED          // Approuvé et intégré au catalogue officiel
  REJECTED          // Refusé par l'équipe avec motif
  ARCHIVED          // Archivé
}

enum DisputeStatus {
  NONE
  PENDING
  ACCEPTED
  REJECTED
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ReportReason {
  TRANSLATION_ERROR      // Erreur de traduction
  TYPO                   // Faute d'orthographe
  INCORRECT_MEANING      // Sens inexact
  INAPPROPRIATE          // Contenu inapproprié
  SPAM                   // Spam ou abus
  MISLEADING             // Contenu trompeur ou mensonger
  ILLEGAL                // Contenu illégal
  OTHER                  // Autre
  // Utilisateurs
  HARASSMENT             // Harcèlement
  IMPERSONATION          // Usurpation d'identité
  SPAM_SCAM              // Spam ou tentative d'arnaque
  INAPPROPRIATE_BEHAVIOR // Comportement toxique ou offensant
  OFFENSIVE_CONTENT      // Contenu injurieux ou haineux
  // UGC (Quiz Sets & Questions)
  WRONG_ANSWER           // Mauvaise réponse / Erreur factuelle
  INAPPROPRIATE_CONTENT  // Contenu offensant ou inadapté
  PLAGIARISM             // Plagiat ou copie non autorisée
  SPELLING_GRAMMAR       // Faute d'orthographe ou formulation incompréhensible
}
