// ============================================================
// MODÈLES — CONTRIBUTIONS COMMUNAUTAIRES
// ============================================================

model Contribution {
  id       String        @id @default(cuid())
  category CategoryType
  textMg   String        @db.Text
  textFr   String        @db.Text
  meaning  String        @db.Text
  region   String?
  status   ContributionStatus @default(DRAFT)
  score     Int           @default(0)
  viewCount Int           @default(0)

  // Détection & Modération automatique des contenus
  moderationFlagged      Boolean   @default(false)
  moderationCategories   String[]  @default([])
  moderationReason       String?   @db.Text
  moderationDetails      Json?     // Stocke les occurrences et détails pour la modération admin
  moderatedAt            DateTime?
  adminFeedback          String?   @db.Text // Motif ou consignes lors d'un rejet ou demande de modifications
  adminReviewedBy        String?   // Identifiant de l'administrateur
  adminReviewedAt        DateTime?
  lastNotificationSentAt DateTime? // Anti-spam / anti-doublon d'envoi d'e-mail d'alerte

  // Détection & Modération des doublons
  duplicateScore        Float?    // Score de similarité (ex: 0.85 = 85%)
  duplicateOfId         String?   // ID de l'item officiel ou de la contribution parente
  duplicateTypeOf       String?   // 'MALAGASY_ITEM' | 'CONTRIBUTION'
  duplicateTargetTitle  String?   // Titre/extrait du contenu existant
  isDuplicateConfirmed  Boolean   @default(false)
  markedForDeletionAt   DateTime? // Fin du compte à rebours 24h

  // Réclamation et contestation du contributeur
  disputeMessage        String?   @db.Text
  disputeStatus         DisputeStatus @default(NONE)
  disputedAt            DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes     ContributionVote[]
  comments  ContributionComment[]
  auditLogs ContributionAuditLog[]
  reports   ContentReport[]

  @@index([userId])
  @@index([status])
  @@index([moderationFlagged])
  @@index([isDuplicateConfirmed])
  @@index([markedForDeletionAt])
  @@map("contributions")
}

model ContributionVote {
  id             String       @id @default(cuid())
  value          Int          // 1 pour Upvote, -1 pour Downvote

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  contributionId String
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, contributionId])
  @@index([contributionId])
  @@map("contribution_votes")
}

model ContributionComment {
  id             String       @id @default(cuid())
  content        String       @db.Text

  parentId       String?
  parent         ContributionComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ContributionComment[] @relation("CommentReplies")

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  contributionId String
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  reports        ContentReport[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([contributionId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@map("contribution_comments")
}

model ContributionAuditLog {
  id             String              @id @default(cuid())
  contributionId String
  contribution   Contribution        @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  userId         String?             // ID utilisateur ou modérateur ayant agi
  userRole       String?             // 'ADMIN' | 'USER' | 'SYSTEM'
  action         String              // 'CREATED_DRAFT', 'SUBMITTED', 'MODERATION_FLAGGED', 'APPROVED', 'REJECTED', 'CHANGES_REQUESTED', 'UPDATED'
  fromStatus     ContributionStatus?
  toStatus       ContributionStatus?
  reason         String?             @db.Text
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([contributionId])
  @@index([action])
  @@index([createdAt])
  @@map("contribution_audit_logs")
}
