// ============================================================
// MODÈLES — CIVIQUE
// Contenus civiques bilingues
// Quiz civique éducatif (QCM)
// Histoire, Mémoire & Emblèmes (CivicLesson)
// ============================================================

// ---------- Contenus civiques ----------

model CivicContent {
  id          String           @id @default(cuid())
  slug        String           @unique
  subCategory CivicSubCategory
  titleFr     String
  titleMg     String
  summaryFr   String?          @db.Text
  summaryMg   String?          @db.Text
  contentFr   String[] // Paragraphes en français
  contentMg   String[] // Paragraphes en malgache
  themes      String[]         @default([])
  sources     String[]         @default([])
  imageUrl    String?
  status      ContentStatus    @default(PUBLISHED)

  // Compteurs
  viewCount  Int @default(0)
  likesCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  structureRoles CivicStructureRole[]
  likes          Like[]

  @@index([subCategory])
  @@index([status])
  @@index([createdAt])
  @@map("civic_contents")
}

model CivicStructureRole {
  id         String @id @default(cuid())
  orderIndex Int    @default(0)
  titleFr    String
  titleMg    String
  roleFr     String @db.Text
  roleMg     String @db.Text

  civicContentId String
  civicContent   CivicContent @relation(fields: [civicContentId], references: [id], onDelete: Cascade)

  @@index([civicContentId])
  @@map("civic_structure_roles")
}

// ---------- Quiz civique éducatif (QCM) ----------

model CivicQuizQuestion {
  id          String          @id @default(cuid())
  category    String // Ex: "droits_devoirs_vote", "symboles_identite"
  prompt      String          @db.Text
  choices     String[] // 4 choix de réponse
  answerIndex Int // Index de la bonne réponse (0-3)
  explanation String          @db.Text
  difficulty  DifficultyLevel @default(EASY)
  tags        String[]        @default([])
  status      ContentStatus   @default(PUBLISHED)

  timesPlayed  Int @default(0)
  timesCorrect Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers CivicQuizAnswer[]

  @@index([category])
  @@index([difficulty])
  @@index([status])
  @@map("civic_quiz_questions")
}

model CivicQuizSession {
  id              String             @id @default(cuid())
  userId          String?
  category        String?
  difficulty      DifficultyLevel    @default(EASY)
  score           Int                @default(0)
  totalQuestions  Int                @default(10)
  streakMax       Int                @default(0)
  durationSeconds Int                @default(0)
  isCompleted     Boolean            @default(false)
  xpEarned        Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  answers         CivicQuizAnswer[]

  @@index([userId])
  @@index([createdAt])
  @@map("civic_quiz_sessions")
}

model CivicQuizAnswer {
  id         String            @id @default(cuid())
  sessionId  String
  session    CivicQuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   CivicQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswer String?
  isCorrect  Boolean
  answeredAt DateTime          @default(now())

  @@index([sessionId])
  @@index([questionId])
  @@map("civic_quiz_answers")
}

// ---------- Leçons civiques (Histoire, Mémoire & Emblèmes) ----------

model CivicLesson {
  id            String        @id
  category      String[]      @default([])
  titleFr       String
  titleMg       String
  descriptionFr String        @db.Text
  descriptionMg String        @db.Text
  imageUrl      String?
  status        Boolean       @default(true)
  orderIndex    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([orderIndex])
  @@map("civic_lessons")
}
