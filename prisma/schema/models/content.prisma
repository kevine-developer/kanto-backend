// ============================================================
// MODÈLES — CONTENU CULTUREL
// Proverbes, Expressions, Dictons (MalagasyItem)
// Citations & Figures historiques
// Proverbe du jour (DailyProverb)
// Contes traditionnels (Angano)
// Discours traditionnels (Kabary)
// Poésie & Hainteny (Tononkalo)
// Récitations & Tsianjery
// ============================================================

// ---------- MalagasyItem ----------

model MalagasyItem {
  id       String  @id @default(cuid())
  slug     String  @unique // Ex: "ny-fihavanana-tahaka-ny-ketsa"
  malagasy String  @db.Text
  french   String  @db.Text
  meaning  String  @db.Text
  example  String? @db.Text
  phonetic String? // Aide à la prononciation
  audioUrl String? // Fichier audio Cloudinary

  category   CategoryType
  difficulty DifficultyLevel @default(EASY)
  status     ContentStatus   @default(PUBLISHED)
  isPremium  Boolean         @default(false)
  isFeatured Boolean         @default(false)

  // Origines libres ou traditionnelles
  origins String[] @default([])

  // Compteurs & Statistiques
  viewCount   Int @default(0)
  likesCount  Int @default(0)
  shareCount  Int @default(0)
  reportCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  themes          MalagasyItemTheme[]
  dialectVariants DialectVariant[]
  dailyProverbs   DailyProverb[]
  favorites       Favorite[]
  likes           Like[]
  viewHistories   ViewHistory[]
  reports         ContentReport[]

  @@index([category, status])
  @@index([difficulty])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("malagasy_items")
}

model MalagasyItemTheme {
  itemId  String
  themeId String
  item    MalagasyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  theme   Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([itemId, themeId])
  @@map("malagasy_item_themes")
}

model DialectVariant {
  id          String  @id @default(cuid())
  dialectName String // Ex: "Betsimisaraka", "Tsimihety"
  text        String  @db.Text
  audioUrl    String?
  notes       String? @db.Text

  itemId String
  item   MalagasyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([regionId])
  @@map("dialect_variants")
}

// ---------- Citations & Figures historiques ----------

model Author {
  id        String   @id @default(cuid())
  name      String   @unique // Ex: "Jean-Joseph Rabearivelo", "Didier Ratsiraka"
  bio       String?  @db.Text
  birthYear Int?
  deathYear Int?
  avatarUrl String?
  createdAt DateTime @default(now())

  citations Citation[]

  @@map("authors")
}

model Citation {
  id         String        @id @default(cuid())
  citationMg String        @db.Text
  citationFr String        @db.Text
  sourceName String // Nom de la source ou ouvrage
  contexte   String?       @db.Text
  audioUrl   String?
  status     ContentStatus @default(PUBLISHED)
  isPremium  Boolean       @default(false)

  // Statistiques
  viewCount   Int @default(0)
  likesCount  Int @default(0)
  shareCount  Int @default(0)
  reportCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String?
  author   Author? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  themes        CitationTheme[]
  favorites     Favorite[]
  likes         Like[]
  viewHistories ViewHistory[]
  reports       ContentReport[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
  @@map("citations")
}

model CitationTheme {
  citationId String
  themeId    String
  citation   Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([citationId, themeId])
  @@map("citation_themes")
}

// ---------- Proverbe du jour ----------

model DailyProverb {
  id        String       @id @default(cuid())
  date      DateTime     @unique @db.Date
  editorial String?      @db.Text
  itemId    String
  item      MalagasyItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([date])
  @@map("daily_proverbs")
}

// ---------- Contes traditionnels (Angano) ----------

model Conte {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  titleFr      String
  subtitle     String?
  subtitleFr   String?
  author       String?       @default("Angano Malagasy")
  source       String?
  illustration String?
  status       ContentStatus @default(PUBLISHED)
  isFeatured   Boolean       @default(false)
  isPremium    Boolean       @default(false)

  // Morale de l'histoire
  moralMg String? @db.Text
  moralFr String? @db.Text

  // Audio haute définition généré par Google Gemini TTS
  audioUrlMg String?
  audioUrlFr String?

  // Identifiants de contes variantes
  variantIds String[] @default([])

  // Compteurs & Statistiques
  viewCount   Int @default(0)
  likesCount  Int @default(0)
  shareCount  Int @default(0)
  reportCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paragraphs ConteParagraph[]
  themes     ConteTheme[]

  // Relations d'activité
  favorites      Favorite[]
  likes          Like[]
  viewHistories  ViewHistory[]
  contentReports ContentReport[]

  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("contes")
}

model ConteParagraph {
  id              String  @id @default(cuid())
  paragraphNumber Int
  textMg          String  @db.Text
  textFr          String  @db.Text
  illustration    String?

  conteId String
  conte   Conte  @relation(fields: [conteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conteId, paragraphNumber])
  @@index([conteId])
  @@map("conte_paragraphs")
}

model ConteTheme {
  conteId String
  themeId String
  conte   Conte  @relation(fields: [conteId], references: [id], onDelete: Cascade)
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([conteId, themeId])
  @@map("conte_themes")
}

// ---------- Discours traditionnels (Kabary) ----------

model Kabary {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  titleFr         String
  subtitle        String?
  subtitleFr      String?
  occasion        String
  occasionFr      String?
  speakerRoleMg   String?
  speakerRoleFr   String?
  recipientRoleMg String?
  recipientRoleFr String?
  region          String?
  illustration    String?
  status          ContentStatus @default(PUBLISHED)
  isFeatured      Boolean       @default(false)
  isPremium       Boolean       @default(false)

  // Proverbe / Pensée de conclusion
  concludingProverbMg String? @db.Text
  concludingProverbFr String? @db.Text

  // Conseils et protocole rituel
  etiquetteNotesMg String? @db.Text
  etiquetteNotesFr String? @db.Text

  // Compteurs & Statistiques
  viewCount   Int @default(0)
  likesCount  Int @default(0)
  shareCount  Int @default(0)
  reportCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps  KabaryStep[]
  themes KabaryTheme[]

  // Relations d'activité
  favorites      Favorite[]
  likes          Like[]
  viewHistories  ViewHistory[]
  contentReports ContentReport[]

  @@index([status])
  @@index([occasion])
  @@index([createdAt])
  @@map("kabaries")
}

model KabaryStep {
  id            String  @id @default(cuid())
  stepNumber    Int
  stepNameMg    String
  stepNameFr    String
  explanationMg String? @db.Text
  explanationFr String? @db.Text
  textMg        String  @db.Text
  textFr        String  @db.Text

  kabaryId String
  kabary   Kabary @relation(fields: [kabaryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([kabaryId, stepNumber])
  @@index([kabaryId])
  @@map("kabary_steps")
}

model KabaryTheme {
  kabaryId String
  themeId  String
  kabary   Kabary @relation(fields: [kabaryId], references: [id], onDelete: Cascade)
  theme    Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([kabaryId, themeId])
  @@map("kabary_themes")
}

// ---------- Poésie & Hainteny (Tononkalo) ----------

model Poesie {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  titleFr       String
  author        String?
  period        String? // Ex: "1930s", "Ntaolo"
  category      String?       @default("tononkalo") // tononkalo, hainteny, etc.
  explanationMg String?       @db.Text
  explanationFr String?       @db.Text
  status        ContentStatus @default(PUBLISHED)
  isPremium     Boolean       @default(false)
  isFeatured    Boolean       @default(false)

  // Compteurs & Statistiques
  viewCount   Int @default(0)
  likesCount  Int @default(0)
  shareCount  Int @default(0)
  reportCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stanzas PoesieStanza[]

  // Relations d'activité
  favorites      Favorite[]
  likes          Like[]
  viewHistories  ViewHistory[]
  contentReports ContentReport[]

  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("poesies")
}

model PoesieStanza {
  id           String   @id @default(cuid())
  stanzaNumber Int
  versesMg     String[] // Vers en malgache
  versesFr     String[] // Vers en français

  poesieId String
  poesie   Poesie @relation(fields: [poesieId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([poesieId, stanzaNumber])
  @@index([poesieId])
  @@map("poesie_stanzas")
}

// ---------- Récitations & Tsianjery ----------

model Recitation {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  titleFr         String
  author          String?
  description     String?       @db.Text
  durationMinutes Int?
  contentLines    String[] // Lignes du texte à réciter
  references      String[] @default([]) // Sources et références
  tags            String[] @default([])
  status          ContentStatus @default(PUBLISHED)
  isPremium       Boolean       @default(false)
  isFeatured      Boolean       @default(false)

  // Compteurs & Statistiques
  viewCount   Int @default(0)
  likesCount  Int @default(0)
  shareCount  Int @default(0)
  reportCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations d'activité
  favorites      Favorite[]
  likes          Like[]
  viewHistories  ViewHistory[]
  contentReports ContentReport[]

  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("recitations")
}
