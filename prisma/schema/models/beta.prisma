// ============================================================
// MODÈLES — PROGRAMME BÊTA-TESTEURS GOOGLE PLAY
// ============================================================

model BetaTester {
  id              String       @id @default(cuid())
  email           String       @unique
  fullName        String?
  deviceModel     String?      // Modèle smartphone (ex: Samsung Galaxy S23, Xiaomi...)
  androidVersion  String?      // Version Android
  notes           String?      @db.Text
  status          TesterStatus @default(PENDING)
  invitedAt       DateTime?
  inviteCount     Int          @default(0)
  playLinkSent    String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("beta_testers")
}
