// ============================================================
// MODÈLES — SYSTÈME
// Verrouillage des modules & Annonces système
// ============================================================

model ModuleLock {
  id         String     @id @default(cuid())
  key        String     @unique // ex: "game:trueFalseGame", "category:conte", "feature:subscription"
  type       ModuleType
  nameFr     String // Nom français
  nameMg     String // Nom malgache
  isLocked   Boolean    @default(false)
  lockReason String? // Ex: "En cours de maintenance", "Bientôt disponible"
  isVisible  Boolean    @default(true) // Visibilité dans l'application mobile (affiché ou masqué)
  imageUrl   String? // Image / illustration du jeu ou de la catégorie
  bgImageUrl String? // Image d'arrière-plan immersive (Chemin de niveaux / jeu)
  minTier    String?    @default("FREE")
  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())

  @@map("module_locks")
}

model SystemAnnouncement {
  id        String           @id @default(cuid())
  titleFr   String
  titleMg   String
  messageFr String           @db.Text
  messageMg String           @db.Text
  type      AnnouncementType @default(INFO)
  isActive  Boolean          @default(false)
  version   Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([isActive])
  @@map("system_announcements")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  userId      String   // ID de l'administrateur ou modérateur
  userName    String?  // Nom ou email de l'administrateur
  action      String   // ex: "USER_ROLE_CHANGED", "USER_BANNED", "USER_UNBANNED", "REPORT_RESOLVED", "COMMENT_DELETED", "SETTINGS_UPDATED"
  targetType  String   // "USER", "CONTRIBUTION", "COMMENT", "REPORT", "MODULE_LOCK"
  targetId    String   // ID de la ressource concernée
  targetLabel String?  // Libellé textuel pour identification immédiate
  reason      String?  @db.Text // Motif fourni
  details     Json?    // Détails complémentaires ou état antérieur/nouveau
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model EmailLog {
  id             String              @id @default(cuid())
  resendId       String?             // Identifiant retourné par Resend (ex: "re_xxxx")
  idempotencyKey String?             @unique // Clé d'idempotence pour déduplication
  recipient      String              // Adresse e-mail du destinataire
  recipientName  String?             // Nom du destinataire si fourni
  from           String              // Adresse d'expédition
  subject        String              // Objet de l'e-mail
  templateType   String              // Type métier de template (WELCOME, VERIFICATION, etc.)
  status         EmailDeliveryStatus @default(PENDING)
  bounceType     String?             // "Permanent" | "Transient" | "Undetermined"
  bounceSubtype  String?             // "General" | "NoEmail" | "Suppressed" | etc.
  errorReason    String?             @db.Text // Erreur si échec
  attempts       Int                 @default(1)
  lastAttemptAt  DateTime?
  metadata       Json?               // Données contextuelles (ex: userId, contributionId) sans secrets
  events         Json?               // Historique complet des événements webhook reçus
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([recipient])
  @@index([status])
  @@index([templateType])
  @@index([resendId])
  @@index([createdAt])
  @@map("email_logs")
}

model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String   // "BOUNCE_PERMANENT", "COMPLAINT", "MANUAL"
  details   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("email_suppressions")
}

