# =============================================================================
# KANTO BACKEND — Configuration des variables d'environnement
# =============================================================================
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# IMPORTANT : Ne jamais committer le fichier .env dans le dépôt Git !
# =============================================================================

# ─── ENVIRONNEMENT ─────────────────────────────────────────────────────────────
# Valeurs possibles : development | production | test
NODE_ENV="development"

# ─── BASE DE DONNÉES ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:votre_mot_de_passe@localhost:5432/kanto?schema=public"

# ─── PORT SERVEUR ─────────────────────────────────────────────────────────────
PORT=3000

# ─── BETTER AUTH ──────────────────────────────────────────────────────────────
# Clé secrète de signature des sessions (32+ caractères aléatoires).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="votre_secret_better_auth_32_caracteres_minimum"
BETTER_AUTH_URL="http://localhost:3000"
# URL de l'interface d'administration (Next.js kanto-admin) pour les liens de réinitialisation de mot de passe
ADMIN_FRONTEND_URL="http://localhost:3001"

# ─── AUTHENTIFICATION SOCIALE GOOGLE (OPTIONNEL) ──────────────────────────────
# Identifiants OAuth 2.0 obtenus sur Google Cloud Console (https://console.cloud.google.com)
# URI de redirection autorisée à déclarer dans Google Console :
#   http://localhost:3000/api/auth/callback/google  (développement)
#   https://api-kanto.gastsar.fr/api/auth/callback/google  (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origines autorisées en production (séparées par des virgules).
# En développement, laisser vide pour utiliser les origines locales par défaut.
# Exemple production : https://admin.kanto.mg,https://app.kanto.mg
CORS_ORIGINS=""

# ─── GOOGLE GEMINI TTS ────────────────────────────────────────────────────────
# Clé API Google Gemini pour la synthèse vocale (IA vocale des contes)
GEMINI_API_KEY="votre_cle_api_gemini"
# Modèle TTS recommandé
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
# Voix recommandée (Orus: chaude/immersive pour récits)
GEMINI_TTS_VOICE="Orus"

# ─── CLOUDINARY CDN ───────────────────────────────────────────────────────────
# Hébergement des images et fichiers audio sur Cloudinary CDN.
# Obtenir les identifiants sur : https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME="votre_cloud_name"
CLOUDINARY_API_KEY="votre_api_key"
CLOUDINARY_API_SECRET="votre_api_secret"
# Alternative : URL complète (prioritaire si définie)
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# ─── REDIS ────────────────────────────────────────────────────────────────────
# Cache et compteurs. Optionnel : fallback DB automatique si Redis absent.
REDIS_URL="redis://127.0.0.1:6379"

# ─── RESEND (EMAILS TRANSACTIONNELS) ──────────────────────────────────────────
# Envoi d'emails transactionnels (réinitialisation de mot de passe, bienvenue).
# Obtenir la clé API sur : https://resend.com/api-keys
RESEND_API_KEY="re_votre_cle_api_resend"
# Adresse expéditeur (ex: Kanto <onboarding@resend.dev> en dev, ou Kanto <contact@kanto.mg> en prod)
RESEND_FROM_EMAIL="Kanto <onboarding@resend.dev>"

# ─── COMPTE ADMINISTRATEUR PAR DÉFAUT ────────────────────────────────────────
DEFAULT_ADMIN_EMAIL="yvesnarsonkevine@gmail.com"
DEFAULT_ADMIN_PASSWORD="votre_mot_de_passe_admin_securise"
AUTO_CREATE_ADMIN="true"


