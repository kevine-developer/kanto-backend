# =============================================================================
# KANTO BACKEND — Configuration Environnement de Production (VPS Docker)
# =============================================================================
# Copiez ce fichier en .env sur votre VPS :
#   cp .env.production.example .env
# Remplissez impérativement les secrets ci-dessous avant de lancer docker compose.
# =============================================================================

# ─── ENVIRONNEMENT ─────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3000

# ─── BASE DE DONNÉES POSTGRESQL DOCKER ─────────────────────────────────────────
# Identifiants du conteneur PostgreSQL géré par docker-compose
POSTGRES_USER="kanto_user"
POSTGRES_PASSWORD="generer_un_mot_de_passe_robuste_ici"
POSTGRES_DB="kanto_prod"
POSTGRES_PORT=5432

# URL de connexion Prisma (utilise le nom de service Docker "postgres")
DATABASE_URL="postgresql://kanto_user:generer_un_mot_de_passe_robuste_ici@postgres:5432/kanto_prod?schema=public"

# Exécution automatique des migrations au démarrage (recommandé: true)
RUN_MIGRATIONS=true

# ─── CACHE & TEMPS RÉEL REDIS DOCKER ──────────────────────────────────────────
# URL de connexion Redis (utilise le nom de service Docker "redis")
REDIS_URL="redis://redis:6379"
REDIS_PORT=6379

# ─── BETTER AUTH ──────────────────────────────────────────────────────────────
# Clé secrète de signature des sessions JWT (32+ caractères aléatoires).
# Générer sur Linux : openssl rand -hex 32
BETTER_AUTH_SECRET="remplacer_par_un_secret_aleatoire_de_32_caracteres_minimum"

# ─── ROUTAGE TRAEFIK & DOMAINE PUBLIC ──────────────────────────────────────────
# Nom de domaine public configuré dans Traefik (ex: api-kanto.gastsar.fr ou api.kanto.mg)
KANTO_DOMAIN="api-kanto.gastsar.fr"

# URL publique complète de votre API backend (avec https://)
BETTER_AUTH_URL="https://api-kanto.gastsar.fr"

# ─── AUTHENTIFICATION SOCIALE GOOGLE (OPTIONNEL) ──────────────────────────────
# Identifiants OAuth 2.0 obtenus sur Google Cloud Console
# URI de redirection autorisée à déclarer dans Google Console :
#   https://api-kanto.gastsar.fr/api/auth/callback/google
GOOGLE_CLIENT_ID="votre_google_client_id_production.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="votre_google_client_secret_production"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origines autorisées en production (séparées par des virgules).
# Doit inclure l'application web, le backoffice admin, etc.
# Exemple : https://app.kanto.mg,https://admin.kanto.mg
CORS_ORIGINS="https://app.votre-domaine.com,https://admin.votre-domaine.com"

# ─── GOOGLE GEMINI TTS (VOIX & IA) ────────────────────────────────────────────
# Clé API Google Gemini pour la génération audio des contes et le quiz
GEMINI_API_KEY="votre_cle_api_gemini_production"
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
GEMINI_TTS_VOICE="Orus"

# ─── CLOUDINARY CDN (IMAGES & AUDIO) ──────────────────────────────────────────
# Hébergement et distribution CDN des médias
CLOUDINARY_CLOUD_NAME="votre_cloudinary_cloud_name"
CLOUDINARY_API_KEY="votre_cloudinary_api_key"
CLOUDINARY_API_SECRET="votre_cloudinary_api_secret"

# ─── RESEND (EMAILS TRANSACTIONNELS) ──────────────────────────────────────────
# Requis en production par env.validation.ts (mot de passe oublié, alertes)
RESEND_API_KEY="re_votre_cle_api_resend_production"
RESEND_FROM_EMAIL="Kanto <contact@votre-domaine.com>"
